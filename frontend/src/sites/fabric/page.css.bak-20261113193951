  .subs{padding:6px 22px 22px}
}

/* ==== 详细内容（盛行朝代/原料/技艺核心/逐条工序） ==== */
.core-box{margin-top:14px;background:linear-gradient(135deg,rgba(122,34,28,.05),rgba(201,162,39,.09));border:1px solid rgba(201,162,39,.3);border-left:4px solid var(--red);border-radius:9px;padding:13px 16px}
.core-tag{display:inline-block;font-family:var(--kai);font-size:12px;color:var(--red);letter-spacing:2px;background:rgba(122,34,28,.08);padding:2px 11px;border-radius:12px;margin-bottom:9px}
.core-txt{font-size:14.5px;color:var(--ink);line-height:1.85}
.proc-accordion{display:flex;flex-direction:column;gap:8px}
.proc-item{border:1px solid var(--line);border-radius:9px;background:rgba(253,250,243,.62);overflow:hidden;transition:border-color .15s,box-shadow .15s,background .15s}
.proc-item:hover{border-color:var(--gold)}
.proc-item.open{border-color:var(--gold);background:var(--card-solid);box-shadow:var(--shadow)}
.proc-item.no-body{cursor:default}
.proc-head{display:flex;align-items:center;gap:12px;padding:11px 14px;cursor:pointer;user-select:none}
.proc-item.no-body .proc-head{cursor:default}
.proc-n{flex:none;min-width:26px;height:26px;line-height:26px;text-align:center;font-family:var(--kai);font-size:13px;color:#fff;background:linear-gradient(150deg,#a93226,#7a221c);border-radius:6px;box-shadow:0 2px 5px rgba(90,24,18,.25)}
.proc-title{flex:1;font-family:var(--kai);font-size:15px;letter-spacing:1px;color:var(--ink);font-weight:600}
.proc-title b{color:var(--red);font-family:var(--kai);letter-spacing:1px;font-weight:600}
.proc-caret{flex:none;width:16px;height:16px;position:relative}
.proc-caret::before,.proc-caret::after{content:"";position:absolute;background:var(--red);border-radius:2px;transition:transform .18s}
.proc-caret::before{left:1px;top:7px;width:14px;height:2px}
.proc-caret::after{left:7px;top:1px;width:2px;height:14px}
.proc-item.open .proc-caret::after{transform:scaleY(0)}
.proc-item.open .proc-caret::before{transform:rotate(180deg)}
.proc-body{display:none;padding:2px 16px 14px 52px;font-size:14px;color:var(--ink-2);line-height:1.9;border-top:1px dashed var(--line-light)}
.proc-item.open .proc-body{display:block}
.proc-hint{margin-top:4px;font-size:12px;color:var(--ink-3);font-family:var(--kai);letter-spacing:1px}

/* ============ 面料页大横幅（与档案 PageHero grand 同款，作用域限定 #fabRoot） ============ */
#fabRoot .gh-banner{position:relative;min-height:388px;padding:54px 58px 96px;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr);gap:24px;overflow:hidden;color:#f8e7c8;border-radius:16px;background:radial-gradient(circle at 82% 34%,rgba(218,170,90,.22),transparent 24%),linear-gradient(120deg,#58130f 0%,#762019 48%,#9b3725 100%);box-shadow:0 24px 70px rgba(86,34,20,.2);margin:0 0 22px}
#fabRoot .gh-banner::before{content:"";position:absolute;inset:0;background-image:linear-gradient(30deg,rgba(246,216,160,.05) 12%,transparent 12.5%,transparent 87%,rgba(246,216,160,.05) 87.5%,rgba(246,216,160,.05)),linear-gradient(150deg,rgba(246,216,160,.05) 12%,transparent 12.5%,transparent 87%,rgba(246,216,160,.05) 87.5%,rgba(246,216,160,.05));background-size:64px 112px;opacity:.65;pointer-events:none}
#fabRoot .gh-banner::after{content:"";position:absolute;inset:12px;border:1px solid rgba(236,205,143,.18);border-radius:10px;pointer-events:none}
#fabRoot .gh-inner{display:contents}
#fabRoot .gh-pattern{position:absolute;right:-90px;top:-120px;width:460px;height:460px;border:1px solid rgba(236,205,143,.13);border-radius:50%;box-shadow:0 0 0 42px rgba(236,205,143,.035),0 0 0 86px rgba(236,205,143,.025);pointer-events:none}
#fabRoot .gh-copy{position:relative;z-index:2;align-self:center}
#fabRoot .gh-eyebrow{display:flex;align-items:center;gap:10px;font-size:10.5px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:rgba(249,231,199,.7)}
#fabRoot .gh-eyebrow-line{width:34px;height:1px;background:currentColor;opacity:.55}
#fabRoot .gh-dot{opacity:.5;margin:0 2px}
#fabRoot .gh-eyebrow-index{margin-left:4px;padding-left:12px;border-left:1px solid currentColor;opacity:.62}
#fabRoot .gh-title{margin:12px 0 14px;font-family:KaiTi,STKaiti,"Kaiti SC",SimSun,serif;font-size:clamp(60px,6vw,92px);font-weight:400;line-height:.84;letter-spacing:.06em;color:#f4d99f;text-shadow:0 10px 30px rgba(38,8,4,.22)}
#fabRoot .gh-sub{max-width:620px;margin:0;font-size:15px;line-height:2.05;letter-spacing:.08em;color:rgba(255,241,217,.78)}
#fabRoot .gh-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
#fabRoot .gh-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:42px;padding:0 22px;border:1px solid transparent;border-radius:4px;font-size:13.5px;letter-spacing:.12em;cursor:pointer;text-decoration:none;transition:all .2s ease}
#fabRoot .gh-btn-gold{background:linear-gradient(135deg,#e0bd6c,#c9a227);color:#4f130e;border-color:rgba(255,232,184,.4)}
#fabRoot .gh-btn-gold:hover{background:#f0d28c;transform:translateY(-1px)}
#fabRoot .gh-btn-ghost{border-color:rgba(243,213,151,.38);color:#f4dfb9}
#fabRoot .gh-btn-ghost:hover{background:rgba(255,238,205,.1);border-color:rgba(243,213,151,.7)}
#fabRoot .gh-art{position:relative;z-index:1;min-height:200px;color:rgba(238,205,139,.62)}
#fabRoot .gh-orbit{position:absolute;border:1px solid rgba(238,205,139,.14);border-radius:50%;pointer-events:none}
#fabRoot .gh-orbit-a{width:280px;height:280px;right:38px;top:-18px}
#fabRoot .gh-orbit-b{width:214px;height:214px;right:70px;top:16px;border-style:dashed}
#fabRoot .gh-orbit-c{width:340px;height:340px;right:8px;top:-48px;opacity:.55}
#fabRoot .gh-seal{position:absolute;right:70px;top:24px;display:grid;place-items:center;width:130px;height:130px;border:1px solid rgba(237,205,142,.52);border-radius:50%;background:rgba(63,15,11,.18);box-shadow:inset 0 0 0 8px rgba(237,205,142,.06),0 0 0 1px rgba(237,205,142,.08);font-family:KaiTi,STKaiti,"Kaiti SC",SimSun,serif;font-size:64px;color:#f4d99f;text-shadow:0 6px 24px rgba(38,8,4,.3)}
#fabRoot .gh-seal::before,#fabRoot .gh-seal::after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(238,205,139,.2)}
#fabRoot .gh-seal::before{inset:-18px}
#fabRoot .gh-seal::after{inset:18px;border-style:dashed;opacity:.6}
#fabRoot .gh-vertical{position:absolute;right:20px;top:42px;writing-mode:vertical-rl;font-size:9px;letter-spacing:.32em;color:rgba(246,223,184,.46)}
#fabRoot .gh-stats{position:absolute;left:58px;right:58px;bottom:24px;z-index:2;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid rgba(236,205,143,.2);padding-top:15px}
#fabRoot .gh-stat{display:flex;align-items:baseline;gap:12px;padding-left:20px;border-left:1px solid rgba(236,205,143,.18)}
#fabRoot .gh-stat:first-child{padding-left:0;border-left:0}
#fabRoot .gh-stat b{font-family:"Songti SC","Noto Serif SC","STSong",SimSun,serif;font-size:28px;font-weight:400;line-height:1;color:#f3d28d}
#fabRoot .gh-stat span{font-size:10px;letter-spacing:.16em;color:rgba(255,241,217,.55)}
@media (max-width:900px){#fabRoot .gh-banner{grid-template-columns:1fr;padding:36px 26px 90px}#fabRoot .gh-art{min-height:220px;opacity:.55}#fabRoot .gh-stats{left:26px;right:26px}}
@media (max-width:640px){#fabRoot .gh-banner{padding:28px 20px 100px}#fabRoot .gh-title{font-size:64px}#fabRoot .gh-stats{grid-template-columns:repeat(2,1fr);row-gap:14px;left:20px;right:20px}}

/* fab-sec-align: 区块标题对齐档案页 AccSectionHead（金竖条 + serif 27px） */
#fabRoot .sec-head{padding-bottom:12px;margin-bottom:22px}
#fabRoot .sec-head h2{font-family:var(--kai);font-size:27px;letter-spacing:2px;gap:12px}
#fabRoot .sec-head h2::before{content:"";width:5px;height:22px;border-radius:3px;background:linear-gradient(180deg,#d9b33d,#a07d16);box-shadow:none}
