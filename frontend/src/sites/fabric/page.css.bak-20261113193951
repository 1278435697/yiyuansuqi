
.fab-page{
  --bg:#f5efe4; --bg-deep:#efe4d2; --bg-deep2:#efe6d6;
  --card:rgba(255,253,248,.92); --card-solid:#fffdf8;
  --line:#d8cbb0; --line-light:#e4dcc8; --gold-line:rgba(201,162,39,.3);
  --ink:#3a2f24; --ink-2:#5c4c3a; --ink-3:#9a8a70; --ink-text:#6b5a45;
  --red:#7a221c; --red-deep:#5d1a15; --red-mid:#a93226; --red-bright:#8f2f23;
  --gold:#c9a227; --gold-deep:#a07d16; --gold-soft:#fdf6e6; --gold-line2:#ecd9ab;
  --serif:"Songti SC","Noto Serif SC","STSong","SimSun",serif;
  --kai:"KaiTi","STKaiti","Kaiti SC","SimSun",serif;
  --sans:"Microsoft YaHei","PingFang SC","Helvetica Neue",-apple-system,"Segoe UI",sans-serif;
  --shadow:0 4px 14px rgba(90,60,30,.1);
  --shadow-h:0 12px 30px rgba(90,60,30,.18);
}
.fab-page,.fab-page *{box-sizing:border-box;margin:0;padding:0}

.fab-page{
  background:var(--bg); color:var(--ink);
  font-family:var(--serif); line-height:1.8; font-size:15px;
  -webkit-font-smoothing:antialiased;
}
/* 背景层：中式古典纹样整屏图 + 暖棕点阵 + 中央金色光晕 */
.app-bg{position:fixed;top:0;left:0;right:0;bottom:0;z-index:-2;background-color:var(--bg);background-image:url("data:image/jpeg;base64,");background-size:cover;background-position:center;background-repeat:no-repeat;transform:translateZ(0)}
.app-bg::before{content:"";position:absolute;top:0;left:0;right:0;bottom:0;background-image:radial-gradient(rgba(178,132,86,.12) 1px,transparent 1px);background-size:26px 26px}
.app-bg::after{content:"";position:absolute;left:50%;top:42%;width:780px;height:780px;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(200,164,110,.15) 0%,transparent 62%);pointer-events:none}
.fab-page a{color:inherit;text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
/* top nav */
/* 顶栏：与主站 .app-header 完全一致 */
.topbar{position:sticky;top:0;z-index:50;background:rgba(122,34,28,.92);backdrop-filter:blur(8px);border-bottom:1px solid rgba(201,162,39,.5);box-shadow:0 2px 14px rgba(60,20,12,.25)}
.topbar .inner{display:flex;align-items:center;gap:24px;padding:10px 0}
.brand{display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;flex-shrink:0;font-family:var(--serif)}
.brand .logo{width:44px;height:44px;border-radius:8px;object-fit:cover;box-shadow:0 2px 8px rgba(60,20,12,.3)}
.brand-text h1{margin:0;font-size:18px;letter-spacing:2px;color:#f5efe4;white-space:nowrap;font-weight:700;font-family:var(--serif)}
.brand-text p{margin:0;font-size:12px;color:rgba(245,239,228,.72);font-family:var(--serif)}
.nav{display:flex;gap:2px;align-items:center;flex:1;flex-wrap:wrap}
.nav a{font-family:"Songti SC","Noto Serif SC","STSong","SimSun",serif;font-size:15px;letter-spacing:1px;color:rgba(245,239,228,.88);padding:8px 12px;border-radius:4px;text-decoration:none;transition:all .2s;white-space:nowrap;background:transparent;font-weight:400}
.nav a:hover{color:#ffe9a8;background:rgba(255,255,255,.12);transform:translateY(-1px)}
.nav a.active{color:#ffe9a8;font-weight:700;background:rgba(255,244,214,.18);box-shadow:inset 0 -2px 0 0 rgba(255,233,168,.65)}
.ys-login{color:#f5efe4;text-decoration:none;font-size:14px;border:1px solid rgba(245,239,228,.4);padding:6px 14px;border-radius:4px;font-family:var(--serif);flex-shrink:0;white-space:nowrap}
.subnav{padding:14px 0 0;position:relative;z-index:2}
.subnav-inner{display:inline-flex;gap:6px;background:rgba(255,253,248,.9);border:1px solid var(--gold-line);border-radius:999px;padding:5px;box-shadow:0 2px 10px rgba(90,60,30,.08)}
.subnav a{font-family:var(--kai);font-size:14px;letter-spacing:1px;color:var(--ink-2);padding:5px 16px;border-radius:999px;cursor:pointer;transition:.15s}
.subnav a:hover{color:var(--red);background:rgba(122,34,28,.06)}
.subnav a.active{color:#fff6e2;background:linear-gradient(150deg,#a93226,#7a221c);box-shadow:0 2px 6px rgba(90,24,18,.3)}
/* hero —— 参照参考站 PageHero：暗红→金渐变实底 + 淡金内框 + 双角标 + 印章 + 回纹 */
.hero{position:relative;overflow:hidden;border-radius:14px;background:radial-gradient(1100px 360px at 85% -60%,rgba(185,138,47,.34),transparent 62%),linear-gradient(135deg,#7e2418,#a93226 55%,#b98a2f 130%);color:#fff;padding:34px 38px 38px;margin:26px 0 22px;box-shadow:0 10px 26px rgba(122,58,32,.22)}
.hero::after{content:"";position:absolute;left:22px;right:22px;bottom:0;height:1px;background:linear-gradient(90deg,transparent,rgba(246,231,191,.75),transparent)}
.hero-frame{position:absolute;top:8px;right:8px;bottom:8px;left:8px;z-index:2;pointer-events:none;border:1px solid rgba(255,244,214,.38);border-radius:10px}
.hero-frame::before,.hero-frame::after{content:"";position:absolute;width:16px;height:16px;border:2px solid rgba(246,231,191,.9)}
.hero-frame::before{top:-1px;left:-1px;border-right:none;border-bottom:none;border-top-left-radius:10px}
.hero-frame::after{bottom:-1px;right:-1px;border-left:none;border-top:none;border-bottom-right-radius:10px}
.hero-fret{position:absolute;top:-40px;right:-40px;bottom:-40px;left:-40px;z-index:1;pointer-events:none;opacity:.16;background-image:repeating-linear-gradient(45deg,transparent 0 18px,rgba(255,255,255,.5) 18px 20px),repeating-linear-gradient(-45deg,transparent 0 18px,rgba(255,255,255,.5) 18px 20px);-webkit-mask-image:linear-gradient(to bottom,transparent,#000 40%);mask-image:linear-gradient(to bottom,transparent,#000 40%)}
.hero-inner{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:20px}
.hero-text{flex:1;min-width:0}
.hero .kicker{display:inline-block;font-family:var(--kai);color:#ffe9c9;letter-spacing:3px;font-size:13px;opacity:.9;margin-bottom:2px}
.hero h1{font-family:var(--kai);font-size:38px;letter-spacing:3px;font-weight:800;color:#fff;line-height:1.2;margin:4px 0 8px;text-shadow:0 6px 18px rgba(38,8,4,.25)}
.hero .sub{max-width:660px;margin:0;color:rgba(255,255,255,.92);font-size:14.5px;line-height:1.85}
.hero .sub .dot{color:rgba(255,233,201,.85);margin:0 6px}
.hero-seal{flex:none;width:64px;height:64px;border:3px solid rgba(255,255,255,.85);display:grid;place-items:center;border-radius:10px;font-size:32px;font-weight:800;transform:rotate(8deg);color:#ffe9c9;background:rgba(126,36,24,.35);font-family:var(--kai);text-shadow:0 2px 8px rgba(38,8,4,.3)}
@media(max-width:640px){.hero{padding:24px 20px 28px}.hero h1{font-size:28px}.hero-seal{width:52px;height:52px;font-size:26px}}
/* section */
.section{margin:46px 0}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;border-bottom:1px solid var(--gold-line);padding-bottom:10px}
.sec-head h2{font-family:var(--kai);font-size:25px;letter-spacing:3px;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:12px}
.sec-head h2::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 0 4px rgba(122,34,28,.14)}
.sec-head .more{font-family:var(--kai);color:var(--ink-3);font-size:14px;cursor:pointer}
.sec-head .more:hover{color:var(--red)}
.sec-head .cat-note{font-size:13px;color:var(--ink-3);font-family:var(--kai)}
/* theme grid */
.theme-cat{margin-bottom:30px}
.theme-cat-title{font-family:var(--kai);font-size:16px;color:var(--red);letter-spacing:2px;margin:0 0 14px;padding-left:12px;border-left:3px solid var(--gold)}
.grid-themes{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.theme-card{background:var(--card);border:1px solid var(--gold-line);border-radius:12px;cursor:pointer;position:relative;overflow:hidden;transition:.18s;box-shadow:var(--shadow);height:150px;padding:0;display:flex;flex-direction:column;justify-content:flex-end}
.theme-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-h);border-color:var(--gold)}
.theme-card .bg{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .28s ease}
.theme-card:hover .bg{transform:scale(1.06)}
.theme-card .ov{position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,18,12,.06) 0%,rgba(26,18,12,.28) 46%,rgba(26,18,12,.82) 100%)}
.theme-card .ct{position:relative;z-index:2;padding:14px 16px}
.theme-card h3{font-family:var(--kai);font-size:19px;letter-spacing:2px;font-weight:600;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.55);margin:0}
.theme-card .cnt{display:inline-block;margin-top:5px;font-size:11.5px;color:#fff;background:rgba(122,34,28,.6);padding:2px 9px;border-radius:20px}
.theme-card .intro{font-size:12.5px;color:rgba(255,255,255,.93);margin-top:6px;line-height:1.5;text-shadow:0 1px 2px rgba(0,0,0,.45)}
.theme-card::after{content:"";position:absolute;left:0;bottom:0;height:3px;width:100%;background:linear-gradient(90deg,var(--c,var(--red)),var(--gold));opacity:.9;z-index:3}
/* filters */
.filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px;align-items:center}
.search{flex:1;min-width:200px;position:relative}
.search input{width:100%;padding:10px 14px 10px 38px;border:1px solid var(--line);border-radius:9px;background:var(--card-solid);font-size:14px;font-family:var(--sans);color:var(--ink);outline:none}
.search input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,162,39,.14)}
.search .ic{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--ink-3);font-size:15px}
.filters select{padding:10px 12px;border:1px solid var(--line);border-radius:9px;background:var(--card-solid);font-size:13.5px;color:var(--ink-2);cursor:pointer;font-family:var(--sans);outline:none}
.filters select:focus{border-color:var(--gold)}
.filters .reset{cursor:pointer;color:var(--ink-3);font-size:13px;padding:8px 4px}
.filters .reset:hover{color:var(--red)}
/* item cards */
.grid-items{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.item-card{background:var(--card);border:1px solid var(--gold-line);border-radius:12px;overflow:hidden;cursor:pointer;transition:.18s;display:flex;flex-direction:column;box-shadow:var(--shadow)}
.item-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-h);border-color:var(--gold)}
.item-card .cover{height:165px;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--c1,var(--red-mid)) 0%,var(--c2,var(--red-deep)) 100%)}
.item-card .cover .cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.item-card .cover .cover-char{position:absolute;right:8px;bottom:8px;z-index:2;min-width:28px;height:28px;line-height:28px;text-align:center;font-family:var(--kai);font-size:16px;color:#fff;background:linear-gradient(150deg,#a93226,#7a221c);border-radius:5px;box-shadow:inset 0 0 0 1.5px rgba(255,244,214,.6);padding:0 5px}
.item-card .cover::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.08),transparent 72%)}
.item-card .cover .lvl{position:absolute;top:8px;right:8px;z-index:2;font-size:11px;background:rgba(60,20,12,.32);color:#fff;padding:2px 8px;border-radius:12px;font-family:var(--sans)}
.item-card .cover .pending{position:absolute;top:8px;left:8px;z-index:2;font-size:11px;background:rgba(255,253,248,.92);color:var(--red);padding:2px 8px;border-radius:12px;font-family:var(--sans)}
.item-card .body{padding:13px 15px 15px;flex:1;display:flex;flex-direction:column}
.item-card h3{font-family:var(--kai);font-size:19px;letter-spacing:1px;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.item-card h3 .alt{font-size:12px;color:var(--ink-3);font-weight:400}
.item-card .brief{font-size:13px;color:var(--ink-2);margin-top:7px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.item-card .tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:auto;padding-top:11px}
.tag{font-size:11px;color:var(--ink-2);background:rgba(247,240,226,.8);border:1px solid var(--line);padding:2px 7px;border-radius:5px}
.tag.red{color:var(--red);background:rgba(122,34,28,.06);border-color:rgba(122,34,28,.18)}
.tag.gold{color:var(--gold-deep);background:rgba(201,162,39,.1);border-color:rgba(201,162,39,.24)}
/* breadcrumb */
.crumb{display:flex;align-items:center;flex-wrap:wrap;gap:7px;font-size:13.5px;color:var(--ink-3);margin:26px 0 0;font-family:var(--kai)}
.crumb a{cursor:pointer;color:var(--ink-2)}
.crumb a:hover{color:var(--red)}
.crumb .sep{color:var(--gold)}
.crumb .cur{color:var(--red)}
/* detail */
.detail{background:var(--card);border:1px solid var(--gold-line);border-radius:10px;box-shadow:var(--shadow);overflow:hidden;margin:20px 0 60px}
.detail::before{content:"";display:block;height:3px;background:linear-gradient(90deg,transparent,#7e2418 30%,var(--gold) 70%,transparent)}
.detail-head{padding:34px 36px;display:flex;gap:30px;align-items:flex-start;flex-wrap:wrap}
.detail-head .cover{width:200px;height:250px;flex:none;border-radius:12px;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--c1,var(--red-mid)),var(--c2,var(--red-deep)));box-shadow:inset 0 0 0 2px rgba(255,244,214,.5)}
.detail-head .cover .cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.detail-head .cover .cover-char{position:absolute;right:12px;bottom:12px;z-index:2;min-width:46px;height:46px;line-height:46px;text-align:center;font-family:var(--kai);font-size:26px;color:#fff;background:linear-gradient(150deg,#a93226,#7a221c);border-radius:6px;box-shadow:inset 0 0 0 1.5px rgba(255,244,214,.6);padding:0 6px}
.cover{cursor:zoom-in}
.cover .cover-img{transition:transform .25s ease}
.cover:hover .cover-img{transform:scale(1.04)}
.cover::before{content:"点击查看大图";position:absolute;left:8px;top:8px;z-index:3;font-size:11px;color:#fff;background:rgba(30,20,15,.55);padding:3px 8px;border-radius:4px;opacity:0;transition:opacity .2s;pointer-events:none;letter-spacing:1px}
.cover:hover::before{opacity:1}
.lightbox{position:fixed;inset:0;background:rgba(26,18,12,.93);display:none;align-items:center;justify-content:center;z-index:9999;cursor:zoom-out;flex-direction:column;padding:20px}
.lightbox.open{display:flex}
.lightbox img{max-width:92vw;max-height:80vh;border-radius:8px;box-shadow:0 24px 70px rgba(0,0,0,.65);border:2px solid rgba(201,162,39,.45);background:#f5efe4}
.lightbox .lb-name{margin-top:16px;color:#f5efe4;font-family:var(--kai);font-size:20px;letter-spacing:3px}
.lightbox .lb-close{position:absolute;top:20px;right:30px;font-size:40px;color:#f5efe4;cursor:pointer;line-height:1;opacity:.7;font-weight:300}
.lightbox .lb-close:hover{opacity:1}
.lightbox .lb-hint{margin-top:6px;color:rgba(245,239,228,.55);font-size:12px;letter-spacing:1px}
.detail-head .info{flex:1;min-width:260px}
.detail-head h1{font-family:var(--kai);font-size:34px;letter-spacing:3px;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.detail-head h1 .alt{font-size:15px;color:var(--ink-3);font-weight:400;letter-spacing:1px}
.detail-head .meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.pill{font-size:12.5px;padding:4px 12px;border-radius:20px;background:rgba(247,240,226,.8);border:1px solid var(--line);color:var(--ink-2)}
.pill.dy{background:rgba(122,34,28,.07);border-color:rgba(122,34,28,.2);color:var(--red)}
.detail-head .brief{font-size:15.5px;color:var(--ink-2);margin-top:16px;line-height:1.85}
.detail-head .themes{margin-top:16px;display:flex;flex-wrap:wrap;gap:7px}
/* note box */
.note{display:flex;gap:12px;align-items:flex-start;background:var(--gold-soft);border:1px solid var(--gold-line2);border-left:4px solid var(--gold);border-radius:9px;padding:13px 16px;margin:0 36px 6px;font-size:13.5px;color:#7a5b16;line-height:1.75}
.note .ic{flex:none;font-size:15px;line-height:1.5;color:var(--gold-deep)}
/* fields */
.fields{padding:8px 36px 30px}
.field{border-bottom:1px dashed var(--line);padding:18px 0}
.field:last-child{border-bottom:none}
.field .k{font-family:var(--kai);font-size:14px;color:var(--red);letter-spacing:2px;margin-bottom:9px;display:flex;align-items:center;gap:8px}
.field .k::before{content:"·";font-size:18px;color:var(--gold)}
.field .v{font-size:14.5px;color:var(--ink);line-height:1.9}
.field .v .dy-list{display:flex;flex-wrap:wrap;gap:7px}
.field .v ul{padding-left:20px}
.field .v li{margin:3px 0}
.field .v .todo{color:var(--ink-3);font-style:italic}
/* sub species */
.subs{padding:6px 36px 26px}
.subs .st{font-family:var(--kai);font-size:14px;color:var(--red);letter-spacing:2px;margin-bottom:13px;display:flex;align-items:center;gap:8px}
.subs .st::before{content:"·";font-size:18px;color:var(--gold)}
.subs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.sub-card{border:1px solid var(--gold-line);border-radius:10px;padding:15px 14px;cursor:pointer;background:rgba(253,250,243,.9);transition:.15s;position:relative}
.sub-card:hover{border-color:var(--gold);box-shadow:var(--shadow-h);transform:translateY(-2px)}
.sub-card h4{font-family:var(--kai);font-size:17px;letter-spacing:1px;color:var(--ink)}
.sub-card .b{font-size:12.5px;color:var(--ink-2);margin-top:6px;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* back link */
.backlink{display:inline-flex;align-items:center;gap:6px;font-family:var(--kai);color:var(--red);cursor:pointer;margin:0 0 2px;font-size:14.5px}
.backlink:hover{opacity:.8}
/* theme page */
.theme-hero{margin:22px -24px 26px;padding:56px 48px 42px;min-height:340px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;background:var(--card) center/cover no-repeat;color:#fff}
.theme-hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(42,22,12,.12) 0%,rgba(42,22,12,.2) 34%,rgba(42,22,12,.82) 100%);z-index:0}
.theme-hero::after{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,#e8c56a 30%,#f6e6b8 70%,transparent);z-index:1}
.theme-hero .ch{position:absolute;right:16px;top:-26px;font-size:160px;font-family:var(--kai);opacity:.14;color:#fff;z-index:0}
.theme-hero .cat{position:relative;z-index:2;font-family:var(--kai);color:#ecc96a;letter-spacing:3px;font-size:13px;text-shadow:0 1px 3px rgba(0,0,0,.5)}
.theme-hero h1{position:relative;z-index:2;font-family:var(--kai);font-size:36px;letter-spacing:5px;font-weight:600;color:#fff;margin-top:8px;text-shadow:0 2px 8px rgba(0,0,0,.55)}
.theme-hero .intro{position:relative;z-index:2;font-size:15px;color:rgba(255,255,255,.92);margin-top:14px;line-height:1.85;max-width:680px;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.theme-hero .narrative{position:relative;z-index:2;font-size:14px;color:rgba(255,255,255,.96);margin-top:14px;line-height:1.9;max-width:760px;background:rgba(0,0,0,.28);border-left:3px solid var(--gold);padding:10px 16px}
.related{position:relative;z-index:2;display:flex;flex-wrap:wrap;gap:8px;margin-top:18px;align-items:center}
.related .lb{font-size:13px;color:rgba(255,255,255,.75);font-family:var(--kai)}
.related .r{font-size:12.5px;padding:4px 12px;border-radius:18px;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.22);color:#fff;cursor:pointer}
.related .r:hover{border-color:var(--gold);color:#ffe9b0}
/* footer */
.footer{border-top:1px solid var(--gold-line);margin-top:60px;padding:30px 0 44px;text-align:center;color:var(--ink-3);font-size:13px;font-family:var(--kai)}
.footer .seal{display:inline-block;width:30px;height:30px;line-height:30px;border-radius:6px;background:linear-gradient(150deg,#a93226,#7a221c 60%,#5d1a15);color:#fff;margin-bottom:10px;font-size:16px;box-shadow:inset 0 0 0 2px rgba(255,244,214,.6)}
/* empty */
.empty{text-align:center;color:var(--ink-3);padding:50px 0;font-family:var(--kai)}
.placeholder{opacity:.82}
@media(max-width:900px){
  .grid-themes,.grid-items,.subs-grid{grid-template-columns:repeat(2,1fr)}
  .detail-head .cover{width:130px;height:165px;font-size:56px}
}
