    {
      "id": "quju",
      "dynasty": "先秦 · 战国",
      "dynastyShort": "先秦",
      "name": "曲裾深衣",
      "category": "深衣 / 礼制常服",
      "pattern": "凤纹绣、菱格几何纹",
      "material": "绢、绣罗（平绣 / 锁绣）",
      "colors": ["#a2543a", "#6d3320", "#d9b06a"],
      "history": "深衣盛行于战国至西汉，上衣下裳连为一体，衣襟接长绕体而下，称「曲裾」。江陵马山一号楚墓与曾侯乙墓出土的凤纹绣绢衣，是迄今所见最早的凤纹刺绣实物之一。深衣「续衽钩边」的形制，也是后世汉服交领右衽体系的源头。",
      "highlights": ["交领右衽，衣襟绕体一周", "凤纹绣与菱格纹并施", "礼制与日常穿着兼具"],
      "position": { "x": -6.6, "y": 0, "z": -1 },
