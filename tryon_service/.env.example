# ============ 衣溯AI 虚拟试穿后端配置示例 ============
# 复制为 .env 后按需修改；所有字段均有代码内默认值，缺省也能启动。

# 试穿推理后端：auto | hrviton | tps | mock
# auto = 按 hrviton -> tps -> mock 自动探测可用性并降级（推荐）
YISU_VTON_BACKEND=auto

# 数据库连接串。默认 SQLite（零配置）；上云改成 MySQL 即可，无需改代码：
#   mysql+aiomysql://user:pass@127.0.0.1:3306/yisu_tryon?charset=utf8mb4
YISU_DATABASE_URL=sqlite+aiosqlite:///./data/yisu.db

# 数据与权重目录（相对路径基于 backend/）
YISU_DATA_DIR=./data
YISU_WEIGHTS_DIR=./weights

# 上传限制
YISU_MAX_UPLOAD_MB=12
YISU_OUTPUT_LONG_SIDE=1024

# 强制 CPU 推理（即使检测到 CUDA 也不用 GPU）
YISU_FORCE_CPU=false

# 可选权重路径
YISU_VITONGPU_ONNX=./weights/gcpait_vitongpu_2k.onnx
YISU_U2NET_ONNX=./weights/u2net.onnx
YISU_HRVITON_CKPT_DIR=./weights/hrviton

# 前端源（逗号分隔），CORS 白名单
YISU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 磁盘结果缓存（同 person + 同 garment 复用上次结果）
YISU_ENABLE_DISK_CACHE=true
