# ============ 衣溯AI · 虚拟试穿 sidecar 配置示例 ============
# 复制为 .env 后按需修改；所有字段都有代码内默认值，缺省也能启动。
# 本服务已并入 yisu-ai-platform：默认直接复用平台的 SQLite 正式库，
# 生产（MySQL + nginx）需要改的只有下面标了「生产」的三组。

# ---------- 推理 ----------
# 试穿推理后端：auto | hrviton | tps | mock（auto = hrviton → tps → mock 自动探测降级，推荐）
YISU_VTON_BACKEND=auto
# 即使检测到 CUDA 也强制 CPU 推理
YISU_FORCE_CPU=false

# 可选权重路径（缺文件即自动降级到下一级 Provider，不会启动失败）
YISU_VITONGPU_ONNX=./weights/gcpait_vitongpu_2k.onnx
YISU_U2NET_ONNX=./weights/u2net.onnx
YISU_HRVITON_CKPT_DIR=./weights/hrviton

# ---------- 数据库（已并入平台主库）----------
# 留空 = 用 ../backend/data/yisu_prod.db（平台 SQLite 正式库），本机零配置即可跑。
# 生产改成平台同一个 MySQL 库，并先执行 ../database/tryon_schema.sql 建两张表：
#   YISU_DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/yisu_ai?charset=utf8mb4
#   （异步驱动是 aiomysql，见 requirements-mysql.txt；平台侧同步 ORM 用 pymysql，互不影响）
YISU_DATABASE_URL=
# 平台库文件位置（默认按仓库结构推导，挪过目录才需要改）
# YISU_PLATFORM_DB_PATH=../backend/data/yisu_prod.db
# 是否与平台进程共享 WAL。WAL 会写进库文件且多出 -wal/-shm 旁文件，
# 平台有按单文件拷贝库的习惯，所以默认不开，靠 busy_timeout(15s) 抗瞬时锁冲突。
YISU_SQLITE_WAL=false

# ---------- 目录 ----------
YISU_DATA_DIR=./data
YISU_WEIGHTS_DIR=./weights
YISU_LOGS_DIR=./logs

# ---------- 静态资源 URL（与平台网关对齐）----------
# 只对外挂「素材图 + 示例图 + 结果图」三类，不再整目录暴露 data/（uploads 里是用户原图）。
YISU_ASSET_URL_PREFIX=/tryon-assets
YISU_RESULTS_URL_PREFIX=/tryon-results
# 留空 = <data_dir>/results，由本服务自己挂载提供。
# 生产建议落到平台 uploads 下，复用 nginx 既有的 /uploads 规则，不必新增 location：
#   YISU_RESULTS_ROOT=/www/wwwroot/yisu/backend/uploads/tryon
#   YISU_RESULTS_URL_PREFIX=/uploads/tryon
YISU_RESULTS_ROOT=

# ---------- 上传与输出 ----------
YISU_MAX_UPLOAD_MB=12
YISU_OUTPUT_LONG_SIDE=1024
# 磁盘结果缓存（同 person + 同 garment + 同画质复用上次结果；force_refresh 可跳过）
YISU_ENABLE_DISK_CACHE=true

# ---------- CORS ----------
# 同源部署（nginx 统一入口）时可以留空不放通；跨端口开发才需要列源。
# 写成 `YISU_CORS_ORIGINS=`（空值）等同于「不放通任何跨域源」，逗号分隔多项。
# （早期版本这样写会在启动时直接抛 SettingsError：pydantic-settings 对 list 字段先按 JSON 解，
#  空串不是合法 JSON；现在配置里用 NoDecode + 自定义切分接住了，云端部署实测过）
YISU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
