# fitview-server 运行配置模板（复制为 .env 后填入真实密钥；.env 已被 .gitignore 忽略，禁止入库）

# 监听端口（nginx 将 /fitview-api/* 重写为 /api/* 后转发到此端口）
PORT=8787

# ===== 豆包 Seedream（火山方舟）：正面换装照 / 三视图重绘 =====
# 在火山方舟控制台开通「图片生成」后创建 API Key
ARK_API_KEY=<your-ark-api-key>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 已开通的模型：doubao-seedream-5-0-flash-260915 / doubao-seedream-5-0-pro；4.5 版本当前无权限
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# 出图分辨率：2K（约 ¥0.12/张）或 4K（约 ¥0.25/张）
ARK_IMAGE_SIZE=2K

# ===== 生成式三维供应商：off / tripo / hunyuan / hitem3d =====
# off = 不产生 3D 费用，前端改走本地三视图雕刻
MODEL3D_PROVIDER=tripo

# ----- Tripo H 系列（https://developers.tripo3d.com 创建 API Key）-----
TRIPO_API_KEY=<your-tripo-api-key>
TRIPO_MODEL=v3.1-20260211
# fast / standard / detailed / extreme（extreme = 8K 贴图）
TRIPO_TEXTURE_QUALITY=extreme
# standard / detailed（Ultra 几何，面数上限 200 万）
TRIPO_GEOMETRY_QUALITY=detailed
# 0 = 自适应；detailed 时最高 2000000
TRIPO_FACE_LIMIT=2000000
# 1 = 只喂正面 + 背面，跳过侧面（避免侧脸/帽型污染脸部贴图）
TRIPO_SKIP_SIDE=0

# ----- 腾讯混元生 3D 专业版（控制台 API KEY 页面创建 sk- 开头的 Key）-----
HUNYUAN_API_KEY=<your-hunyuan-api-key>
HUNYUAN_BASE_URL=https://api.ai3d.cloud.tencent.com
HUNYUAN_MODEL=3.0
# 0 = 不传面数，用默认 50 万面，避免额外积分
HUNYUAN_FACE=0

# ----- 火山方舟 HiTem3D（暂停使用，约 ¥10/次）-----
# ARK_3D_MODEL=hitem3d-2-0-251223
# ARK_3D_FACE=1000000
# ARK_3D_RESOLUTION=1536

# 无密钥时强制走本地 mock，便于前端联调（1 = 强制 mock）
# ARK_MOCK=1
