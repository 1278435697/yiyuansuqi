[Unit]
Description=Yisu AI Backend (FastAPI)
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/yisu/backend
ExecStart=/www/wwwroot/yisu/backend/591cde3d08cdc971dd6324b305e8aede_venv/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
